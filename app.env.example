# heartdesk アプリ動作設定のサンプル（環境変数）
# 実際の設定は任意の場所（例: /var/lib/heartdesk/config/app.env）に置く（chmod 600、Git 除外）。
# systemd の EnvironmentFile=-/var/lib/heartdesk/config/app.env などで読み込む。
# 秘密の値（トークン・PIN・パスワード）はこのファイルに書かない。TOML 設定側（HEARTDESK_CONFIG_DIR 配下）に置く。
#
# 現在のコードが環境変数から読むのは、このファイルのうち
# HEARTDESK_ICON / HEARTDESK_ICON_MONITOR_FAVICON / HEARTDESK_WHITELIST_IPS だけ。
# ほかの項目は、同じ意味の設定が TOML 側（internal/config の AppConfig:
# [ui] / [security] / [resource_thresholds] / [nextcloud_cron] / [threat_score] /
# [nginx_errors] / [ssl] / [geoip] / [alerts] 系）にある。元の例を残してあるが、環境変数としての動作は確認していない。

# ========== 表示設定 ==========
HEARTDESK_SSH_ATTACKS_LIMIT=20
HEARTDESK_CARD_DEFAULT_LIMIT=10
# 共通アイコン（/static/img/ 配下のファイル名）
HEARTDESK_ICON=favicon.svg
# Monitor のブラウザタブ用ファビコン（/static/img/ 配下のファイル名）
HEARTDESK_ICON_MONITOR_FAVICON=favicon_monitor.svg

# ========== セキュリティ操作 ==========
# IP 管理カードの PIN ロック期間（分）
HEARTDESK_WLM_PIN_LOCK_MIN=30
# ホワイトリスト IP（WL バッジ表示・BAN 不可対象。カンマ区切り）
HEARTDESK_WHITELIST_IPS=127.0.0.1,::1,203.0.113.10
# audit 異常検知で除外する信頼済み IP（HEARTDESK_WHITELIST_IPS と合わせること）
HEARTDESK_AUDIT_TRUSTED_IPS=127.0.0.1,::1,203.0.113.10

# ========== GeoIP キャッシュ ==========
HEARTDESK_GEOIP_CACHE_TTL_DAYS=7

# ========== リソースバー閾値（%） ==========
HEARTDESK_BAR_THRESHOLD_WARNING=60
HEARTDESK_BAR_THRESHOLD_DANGER=85

# ========== Nextcloud Cron 健全性（秒） ==========
HEARTDESK_NC_CRON_WARN_SEC=300
HEARTDESK_NC_CRON_DANGER_SEC=900

# ========== 脅威スコア表示閾値 ==========
HEARTDESK_THREAT_SCORE_WARN=40
HEARTDESK_THREAT_SCORE_DANGER=80

# ========== Nginx 5xx エラー閾値 ==========
HEARTDESK_NGINX_5XX_THRESHOLD_1H=5
HEARTDESK_NGINX_5XX_THRESHOLD_24H=20

# ========== SSL 確認 ==========
HEARTDESK_SSL_CONNECT_PORT=443

# ========== アラート基本設定 ==========
HEARTDESK_ALERT_EMAIL_ENABLED=true
HEARTDESK_ALERT_EMAIL_TO=admin@example.com
HEARTDESK_ALERT_EMAIL_SUBJECT_PREFIX=[ALERT]
HEARTDESK_ALERT_STATE_FILE=/tmp/alert_state.json
# 規則ファイルの実際の置き場所は $HEARTDESK_BASE_DIR/data/json/alert_rules.json（BASE_DIR 未設定なら /var/lib/heartdesk 配下）。
HEARTDESK_ALERT_RULES_FILE=/var/lib/heartdesk/data/json/alert_rules.json

# ========== メモリアラート ==========
HEARTDESK_ALERT_MEMORY_THRESHOLD_PCT=90.0
HEARTDESK_ALERT_MEMORY_RECOVERY_PCT=85.0
HEARTDESK_ALERT_MEMORY_SUSTAIN_SEC=300
HEARTDESK_ALERT_MEMORY_COOLDOWN_SEC=1800

# ========== ディスクアラート ==========
HEARTDESK_ALERT_DISK_THRESHOLD_PCT=92.0
HEARTDESK_ALERT_DISK_RECOVERY_PCT=88.0
HEARTDESK_ALERT_DISK_SUSTAIN_SEC=300
HEARTDESK_ALERT_DISK_COOLDOWN_SEC=1800

# ========== サービス停止アラート ==========
HEARTDESK_ALERT_SERVICE_WATCH=nginx,mariadb
HEARTDESK_ALERT_SERVICE_SUSTAIN_SEC=120
HEARTDESK_ALERT_SERVICE_COOLDOWN_SEC=900

# ========== 脅威スコアアラート ==========
HEARTDESK_ALERT_THREAT_SCORE_THRESHOLD=100
HEARTDESK_ALERT_THREAT_SCORE_RECOVERY=95
HEARTDESK_ALERT_THREAT_SCORE_COOLDOWN_SEC=1800
