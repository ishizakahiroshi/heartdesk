# heartdesk アプリ動作設定のサンプル（環境変数）
# 実際の設定は任意の場所（例: /etc/heartdesk/app.env）に置く（chmod 600、Git 除外）。
# systemd の EnvironmentFile=-/etc/heartdesk/app.env などで読み込む。
# 秘密の値（トークン・PIN・パスワード）はこのファイルに書かない。TOML 設定側（SAB_CONFIG_DIR 配下）に置く。
#
# 注意（移植途中）: 現在のコードが環境変数から読むのは、このファイルのうち
# SAB_ICON_SAB / SAB_ICON_MONITOR_FAVICON / SAB_WHITELIST_IPS だけ。
# ほかの項目は、同じ意味の設定が TOML 側（internal/config の AppConfig:
# [ui] / [security] / [resource_thresholds] / [nextcloud_cron] / [threat_score] /
# [nginx_errors] / [ssl] / [geoip] / [alerts] 系）にある。元の例を残してあるが、
# 環境変数としての動作は確認していない。
# 環境変数名の SAB_ は旧名のまま（ブランド名の付け替えが未了）。

# ========== 表示設定 ==========
SAB_SSH_ATTACKS_LIMIT=20
SAB_CARD_DEFAULT_LIMIT=10
# 共通アイコン（/static/img/ 配下のファイル名）
SAB_ICON_SAB=favicon_sab.svg
# Monitor のブラウザタブ用ファビコン（/static/img/ 配下のファイル名）
SAB_ICON_MONITOR_FAVICON=favicon_sab_monitor.svg

# ========== セキュリティ操作 ==========
# IP 管理カードの PIN ロック期間（分）
SAB_WLM_PIN_LOCK_MIN=30
# ホワイトリスト IP（WL バッジ表示・BAN 不可対象。カンマ区切り）
SAB_WHITELIST_IPS=127.0.0.1,::1,203.0.113.10
# audit 異常検知で除外する信頼済み IP（SAB_WHITELIST_IPS と合わせること）
SAB_AUDIT_TRUSTED_IPS=127.0.0.1,::1,203.0.113.10

# ========== GeoIP キャッシュ ==========
SAB_GEOIP_CACHE_TTL_DAYS=7

# ========== リソースバー閾値（%） ==========
SAB_BAR_THRESHOLD_WARNING=60
SAB_BAR_THRESHOLD_DANGER=85

# ========== Nextcloud Cron 健全性（秒） ==========
SAB_NC_CRON_WARN_SEC=300
SAB_NC_CRON_DANGER_SEC=900

# ========== 脅威スコア表示閾値 ==========
SAB_THREAT_SCORE_WARN=40
SAB_THREAT_SCORE_DANGER=80

# ========== Nginx 5xx エラー閾値 ==========
SAB_NGINX_5XX_THRESHOLD_1H=5
SAB_NGINX_5XX_THRESHOLD_24H=20

# ========== SSL 確認 ==========
SAB_SSL_CONNECT_PORT=443

# ========== アラート基本設定 ==========
SAB_ALERT_EMAIL_ENABLED=true
SAB_ALERT_EMAIL_TO=admin@example.com
SAB_ALERT_EMAIL_SUBJECT_PREFIX=[ALERT]
SAB_ALERT_STATE_FILE=/tmp/alert_state.json
SAB_ALERT_RULES_FILE=/var/lib/heartdesk/json/alert_rules.json

# ========== メモリアラート ==========
SAB_ALERT_MEMORY_THRESHOLD_PCT=90.0
SAB_ALERT_MEMORY_RECOVERY_PCT=85.0
SAB_ALERT_MEMORY_SUSTAIN_SEC=300
SAB_ALERT_MEMORY_COOLDOWN_SEC=1800

# ========== ディスクアラート ==========
SAB_ALERT_DISK_THRESHOLD_PCT=92.0
SAB_ALERT_DISK_RECOVERY_PCT=88.0
SAB_ALERT_DISK_SUSTAIN_SEC=300
SAB_ALERT_DISK_COOLDOWN_SEC=1800

# ========== サービス停止アラート ==========
SAB_ALERT_SERVICE_WATCH=nginx,mariadb
SAB_ALERT_SERVICE_SUSTAIN_SEC=120
SAB_ALERT_SERVICE_COOLDOWN_SEC=900

# ========== 脅威スコアアラート ==========
SAB_ALERT_THREAT_SCORE_THRESHOLD=100
SAB_ALERT_THREAT_SCORE_RECOVERY=95
SAB_ALERT_THREAT_SCORE_COOLDOWN_SEC=1800
