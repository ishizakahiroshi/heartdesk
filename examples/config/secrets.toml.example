# Minimal secrets.toml for heartdesk.
# Copy to $HEARTDESK_CONFIG_DIR/secrets.toml, keep it out of git, and restrict its permissions
# (for example chmod 600). Replace every <set-me...> marker with your own value.
# Do not reuse any value from this file.

[vendor_license]
# Tenant this Monitor belongs to. Must match the tenant part of the agent IDs
# and of the license_key below. "default" is the tenant ID used when HEARTDESK_TENANT_ID is unset.
tenant_id = "default"
# Checked once at start-up as: "<tenant_id>.<tenant_id>-monitor.<signature>"
# where <signature> = hex(HMAC-SHA256(vendorSecret, "<tenant_id>.<tenant_id>-monitor")).
# vendorSecret is the value you injected at build time (see README, "Build").
license_key = "<set-me: default.default-monitor.hmac-hex-from-readme>"

# Shared key for signing reports, one entry per agent. The agent side (heartpost) must be
# configured with the same value. An agent with no entry here is rejected.
[agent_keys]
"default-web-01" = "<set-me: shared-report-signing-key>"

# Source IPs allowed to send reports for each agent (single IPs or CIDR ranges).
# An agent with no entry, or an empty list, is rejected (HTTP 403).
[agent_allowed_ips]
"default-web-01" = ["203.0.113.10"]
